---
/**
 * Base document shell.
 *
 * Owns the <head>, the persistent chrome (nav, background canvas, footer) and
 * the global stylesheets. Every route renders through this.
 */
import Footer from '~/components/Footer.astro'
import Nav from '~/components/Nav.astro'
import PlumCanvas from '~/components/PlumCanvas.astro'
import { site } from '~/site.config'
import '~/styles/tokens.css'
import '~/styles/base.css'
import '~/styles/components.css'

interface Props {
  /** Page title, without the site name suffix. Omit on the homepage. */
  title?: string
  description?: string
  /** Absolute or root-relative social preview image. */
  image?: string
  /** Set for article pages so Open Graph reports the correct type. */
  type?: 'website' | 'article'
}

const { title, description = site.description, image = '/og.png', type = 'website' } = Astro.props

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — AI engineer`

// Built against Astro.site so these are always absolute, which Open Graph
// requires. Relative URLs here are the single most common cause of link
// previews rendering blank.
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Tells the browser to render form controls and scrollbars for the
        active theme, so native UI does not flash white on a dark page. */}
    <meta name="color-scheme" content="dark light" />

    {/*
      Applied before first paint, on purpose.

      This must run synchronously in <head>. Restoring the stored theme from a
      bundled module would execute after the first paint, producing a visible
      flash of the default theme on every navigation.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('nk-theme')
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored
        }
      } catch {
        /* private browsing — fall through to the default theme */
      }
    </script>
  </head>

  <body>
    <a class="sr-only" href="#main">Skip to content</a>

    <PlumCanvas />

    <div class="page">
      <Nav />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import { mountReveals } from '~/scripts/reveal'
      mountReveals()
    </script>
  </body>
</html>
