---
import Base from '~/layouts/Base.astro'
---

<Base title="Not found" description="That page does not exist.">
  <section class="contact" style="min-height: 60vh; display: grid; place-content: center">
    <div class="container">
      <p class="section-label">404</p>
      <h2 class="grad">This page took a wrong turn.</h2>
      <p class="lede" style="margin: 20px auto 0">The page you asked for does not exist.</p>
      <p style="margin-top: 32px"><a class="btn" href="/">Back home</a></p>
    </div>
  </section>
</Base>
