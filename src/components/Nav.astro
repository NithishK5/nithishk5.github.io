---
/**
 * Sticky translucent navigation.
 *
 * The backdrop filter applies a saturation boost before the blur — without it,
 * translucent chrome desaturates whatever sits behind it and reads grey.
 */
import { site } from '~/site.config'

const path = Astro.url.pathname
/** Marks the active route, tolerating both /projects and /projects/ forms. */
const isCurrent = (href: string): boolean =>
  href !== '/' && href.startsWith('/') && path.replace(/\/$/, '') === href.replace(/\/$/, '')
---

<nav class="nav" aria-label="Primary" transition:persist>
  <a class="mark" href="/" data-nav-mark aria-label={`${site.name} — home`}>nk.</a>

  {
    site.nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))
  }

  <button class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">◐</button>
</nav>

<script>
  import { mountOnce, onPageLoad } from '~/scripts/lifecycle'
  import { mountSamePageLink } from '~/scripts/nav'
  import { mountThemeToggle } from '~/scripts/theme'

  // The nav persists across navigation, so both are wired up exactly once.
  onPageLoad(() => {
    const button = document.querySelector<HTMLElement>('[data-theme-toggle]')
    if (button) mountOnce(button, 'themeMounted', () => mountThemeToggle(button))

    // Every nav link, not just the wordmark: clicking "Projects" while already
    // on /projects triggered the same jarring scroll reset.
    document.querySelectorAll<HTMLAnchorElement>('.nav a[href^="/"]').forEach((link) => {
      mountOnce(link, 'samePageMounted', () => mountSamePageLink(link))
    })
  })
</script>
